# Block execution of script files inside public uploads
<FilesMatch "(?i)\.(php|phtml|phar|php5|php7|php8|cgi|pl|py|sh|bash|exe|asp|aspx)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

Options -ExecCGI -Indexes
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
